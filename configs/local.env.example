# Machine-specific paths; keep the completed local.env private.
TRAJTRACKING_DATASET_ROOT="/path/to/raw_dataset"
TRAJTRACKING_OBJECT_ASSET_ROOT="/path/to/object_assets"
TRAJTRACKING_SCENE_ASSET_ROOT="/path/to/isaac_scene_assets"
TRAJTRACKING_ALIGNMENT_REPORT="/path/to/alignment_report.json"
# Optional isolated NCCL runtime used by your Isaac environment:
# TRAJTRACKING_NCCL_LIBRARY="/path/to/libnccl.so.2"
# PLAYWRIGHT_BROWSERS_PATH="/path/to/playwright_browsers"
# Optional local Isaac extensions if your installation lacks importer dependencies:
# TRAJTRACKING_ISAAC_EXTENSION_ROOT="/path/to/isaac_extensions"
